{
	"name": "rl-ts-client",
	"description": "Rocket League Stats API Client",
	"version": "0.1.2",
	"repository": {
		"type": "git",
  		"url": "git+https://github.com/abgier-avraha/Rocket-League-Stats-API-TS.git",
	    "directory": "client"
	},
	"homepage": "https://github.com/abgier-avraha/Rocket-League-Stats-API-TS/tree/main/client",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./events": {
			"import": "./dist/events/index.js",
			"types": "./dist/events/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"format": "biome lint --fix ./src && biome format --write ./src && tsc",
		"test": "vitest",
		"clean": "rimraf dist",
		"build": "npm run clean && tsc",
		"dev": "tsx ./src/index.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@types/node": "^24.12.2",
		"@types/ws": "^8.18.1",
		"rimraf": "^6.0.1",
		"typescript": "~5.9.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"tsx": "^4.21.0",
		"ws": "^8.20.0",
		"zod": "^4.4.3"
	}
}
