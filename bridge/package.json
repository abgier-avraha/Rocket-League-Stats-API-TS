{
	"name": "rl-ts-bridge",
	"description": "Rocket League Stats API Bridge Server",
	"version": "0.1.5",
	"repository": {
		"type": "git",
  		"url": "git+https://github.com/abgier-avraha/Rocket-League-Stats-API-TS.git",
	    "directory": "bridge"
	},
  "keywords": [
    "rocket-league",
    "rocket-league-stats-api",
    "rocket-league-api",
    "rocket-league-stats",
    "rocket-league-ts",
    "rocketleague",
    "websocket",
    "ws-server",
    "websocket-bridge",
    "bridge-server",
    "real-time",
    "realtime-data",
    "game-telemetry",
    "gaming-api",
    "esports",
    "nodejs",
    "typescript",
    "socket-server",
    "tcp-bridge",
    "api-gateway",
    "event-stream"
  ],
	"homepage": "https://github.com/abgier-avraha/Rocket-League-Stats-API-TS/tree/main/bridge",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
    "./bridge":  {
			"import": "./dist/bridge.js",
			"types": "./dist/bridge.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"bin": {
		"rl-ts-bridge": "./dist/cli.js"
	},
	"scripts": {
		"format": "biome lint --fix ./src && biome format --write ./src && tsc",
		"test": "vitest",
		"clean": "rimraf dist",
		"build": "npm run clean && tsc",
		"dev": "tsx ./src/index.ts",
    "prepublishOnly": "cp ../readme.md ./readme.md"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@types/node": "^24.12.2",
		"@types/ws": "^8.18.1",
		"rimraf": "^6.0.1",
		"typescript": "~5.9.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"tsx": "^4.21.0",
		"ws": "^8.20.0",
		"zod": "^4.4.3"
	}
}
